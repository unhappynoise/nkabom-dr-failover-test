# Excerpt from postgresql.conf on the Primary host (primarysite).
# Only project-specific changes are shown; default PostgreSQL
# boilerplate/comments have been omitted for brevity.

listen_addresses = '*'
wal_level = replica

# TLS configuration for encrypted, certificate-authenticated
# replication (see report Section 4.3)
ssl = on
ssl_cert_file = 'server.crt'
ssl_key_file = 'server.key'
ssl_ca_file = 'ca.crt'
